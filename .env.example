# Render supplies PORT automatically. For local development, copy this file to .env.
PORT=10000
NODE_ENV=development

# PostgreSQL connection string. Use Render's INTERNAL Database URL for services on Render.
DATABASE_URL=postgresql://postgres:password@localhost:5432/airoom

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this stable forever once users have saved encrypted API keys.
ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Google Cloud OAuth Web client ID (same value used by the frontend build).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Comma-separated exact frontend origins, e.g. https://yourname.github.io,https://yourname.github.io/ai-room-web
FRONTEND_ORIGINS=http://localhost:5173

# Optional platform-wide fallback API keys. Prefer each user configuring their own key on each AI.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: enables web search for Claude and OpenAI-compatible providers too.
FIRECRAWL_API_KEY=
